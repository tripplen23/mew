# Required
OPENCODE_GO_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional — server
MEWCODE_PORT=3737
MEWCODE_HOST=127.0.0.1
RUST_LOG=info,mewcode_engine=debug
MEWCODE_THEME=catppuccin-mocha

# Optional — data directory (defaults to $XDG_DATA_HOME/mew or ~/.local/share/mew)
# MEWCODE_DATA_DIR=

# Optional — mew-mcp MCP server
# MEWCODE_SERVER_URL=http://127.0.0.1:3737

# Optional — Langfuse tracing
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional — providers (add API keys for models you use)
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
